# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           app 1.0

name                ngraph-gtk
categories          devel
license             GPL-2+
maintainers         htrb

description         Scientific 2-D graph.
long_description    Ngraph is the program to create scientific 2-dimensional graphs for researchers and engineers.

subport ngraph-gtk-devel {
    conflicts       ngraph-gtk
}

if {${subport} eq ${name}} {
    conflicts       ngraph-gtk-devel
    github.setup    htrb ngraph-gtk 6.10.00 v
    revision        0
    github.tarball_from releases

    checksums       sha256  e791c7e2fd5b8f1c833c8b03018e6a7009f08537bf9b6b9eee7d6015f92874f7 \
                    rmd160  2763d642d4609913efc0ce3aa0e7344642f45b32 \
                    size    3808358

} else {
    # 開発版（ngraph-gtk-devel: HEAD）の設定
    github.setup    htrb ngraph-gtk master
    version         9999
    revision        0
    fetch.type      git
    git.url         https://github.com/htrb/ngraph-gtk.git
    git.branch      master
}

depends_build-append    port:pkgconfig \
                        port:gettext \
                        port:gmake \
                        port:librsvg

depends_lib-append      port:gtksourceview5 \
                        port:gtk4 \
                        port:readline \
                        port:gsl \
                        port:gettext-runtime \
                        port:adwaita-icon-theme

use_autoreconf          yes
autoreconf.args         -fi

build.cmd               ${prefix}/bin/gmake

# configure.args-append   --disable-silent-rules
configure.ldflags-append  -lintl
post-build {
    system -W ${worksrcpath}/po "${build.cmd} ja.gmo"
}

app.create          yes
app.name            Ngraph-GTK
app.executable      ngraph
app.icon            ${worksrcpath}/icons/scalable/apps/ngraph.svg

post-destroot {
    set app_dir "${destroot}${applications_dir}/Ngraph-GTK.app"
    set contents_dir "${app_dir}/Contents"
    xinstall -d -m 0755 "${contents_dir}"

    set fp [open "${contents_dir}/Info.plist" w 0644]
    puts $fp {<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.github.htrb.ngraph-gtk</string>
    <key>CFBundleExecutable</key>
    <string>Ngraph-GTK</string>
    <key>CFBundleIconFile</key>
    <string>Ngraph-GTK.icns</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Ngraph Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.macports.ngraph-gtk.ngp</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>ngp</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>Ngraph-GTK.icns</string>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.text</string>
            </array>
            <key>UTTypeDescription</key>
            <string>Ngraph Document</string>
            <key>UTTypeIconFile</key>
            <string>Ngraph-GTK.icns</string>
            <key>UTTypeIdentifier</key>
            <string>org.macports.ngraph-gtk.ngp</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ngp</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>}
    close $fp
}
